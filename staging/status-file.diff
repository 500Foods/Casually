 local dkjson = load_library("dkjson")
 local terminal = load_library("terminal")
 
+-- Live status file. A small JSON document rewritten atomically (temp file,
+-- then rename) at most every ST.INTERVAL seconds and at every phase
+-- change, so `cat` gives proof of life. It is an observer only: a failed
+-- write never fails the backup. Hot paths call ST.tick(), which only
+-- reads the clock every ST.EVERY calls.
+local ST = {
+    system = require("system"),
+    INTERVAL = 10,
+    EVERY = 64,
+    cur = nil,
+}
+ST.KEYS = {
+    "updated", "pid", "stamp", "profile", "config", "phase", "exit_code",
+    "error", "current_dir", "current_dest", "files_done", "files_total",
+    "bytes_done", "bytes_total", "pct_files", "pct_bytes",
+    "rate_files_per_s", "eta_seconds", "started", "finished", "workers",
+    "progress_source",
+}
+
+function ST.iso()
+    local text = os.date("%Y-%m-%dT%H:%M:%S%z")
+    return (text:gsub("([+-]%d%d)(%d%d)$", "%1:%2"))
+end
+
+function ST.json(v)
+    if v == nil then
+        return "null"
+    end
+    local kind = type(v)
+    if kind == "number" then
+        if v ~= v or v == math.huge or v == -math.huge then
+            return "null"
+        end
+        if math.type(v) == "integer" then
+            return tostring(v)
+        end
+        return string.format("%.1f", v)
+    end
+    if kind == "boolean" then
+        return tostring(v)
+    end
+    return dkjson.quotestring(tostring(v))
+end
+
+function ST.dirname(path)
+    if type(path) ~= "string" then
+        return nil
+    end
+    local dir = path:match("^(.*)/[^/]*$")
+    if dir == nil then
+        return path
+    end
+    if dir == "" then
+        return "/"
+    end
+    return dir
+end
+
+function ST.write()
+    local s = ST.cur
+    local f = s.f
+    local now = ST.system.monotime()
+    s.written = now
+    s.ticks = 0
+    f.updated = ST.iso()
+    f.current_dir = ST.dirname(s.last_path)
+    f.current_dest = s.last_dest
+    local ft, bt = f.files_total, f.bytes_total
+    f.pct_files = (ft and ft > 0) and (math.floor(f.files_done * 1000 / ft) / 10) or nil
+    f.pct_bytes = (bt and bt > 0) and (math.floor(f.bytes_done * 1000 / bt) / 10) or nil
+    f.rate_files_per_s = nil
+    f.eta_seconds = nil
+    if s.copy_at and f.phase == "copying" then
+        local elapsed = now - s.copy_at
+        local moved = f.files_done - s.copy_base
+        if elapsed >= 1 and moved > 0 then
+            local rate = moved / elapsed
+            f.rate_files_per_s = math.floor(rate * 10 + 0.5) / 10
+            if ft then
+                f.eta_seconds = math.floor((ft - f.files_done) / rate + 0.5)
+            end
+        end
+    end
+    local parts = {}
+    for i, key in ipairs(ST.KEYS) do
+        parts[i] = "  " .. ST.json(key) .. ": " .. ST.json(f[key])
+    end
+    local body = "{\n" .. table.concat(parts, ",\n") .. "\n}\n"
+    local tmp = s.path .. ".tmp." .. tostring(f.pid)
+    local h = io.open(tmp, "w")
+    if not h then
+        return
+    end
+    local wrote = h:write(body)
+    local closed = h:close()
+    if not wrote or not closed then
+        os.remove(tmp)
+        return
+    end
+    if s.chmod == nil then
+        s.chmod = lfs.attributes(tmp, "permissions") ~= "rw-r--r--"
+    end
+    if s.chmod then
+        os.execute("chmod 0644 '" .. tmp:gsub("'", "'\\''") .. "'")
+    end
+    if not os.rename(tmp, s.path) then
+        os.remove(tmp)
+    end
+end
+
+function ST.flush()
+    if ST.cur then
+        pcall(ST.write)
+    end
+end
+
+function ST.tick(dest, path)
+    local s = ST.cur
+    if not s then
+        return
+    end
+    if dest then
+        s.last_dest = dest
+    end
+    if path then
+        s.last_path = path
+    end
+    local n = s.ticks + 1
+    s.ticks = n
+    if n < ST.EVERY then
+        return
+    end
+    s.ticks = 0
+    if ST.system.monotime() - s.written >= ST.INTERVAL then
+        ST.flush()
+    end
+end
+
+function ST.progress(done, path)
+    local s = ST.cur
+    if not s then
+        return
+    end
+    s.f.files_done = done
+    if path then
+        s.last_path = path
+    end
+    ST.tick()
+end
+
+function ST.dest(dest)
+    if ST.cur then
+        ST.cur.last_dest = dest
+    end
+end
+
+function ST.bytes(n)
+    local s = ST.cur
+    if s and type(n) == "number" and n > 0 then
+        s.f.bytes_done = s.f.bytes_done + n
+        ST.tick()
+    end
+end
+
+function ST.job_done(job)
+    local s = ST.cur
+    if not s then
+        return
+    end
+    s.f.files_done = s.f.files_done + 1
+    s.f.bytes_done = s.f.bytes_done + (job.size or 0)
+    s.last_path = job.source
+    ST.tick()
+end
+
+function ST.phase(phase)
+    local s = ST.cur
+    if not s then
+        return
+    end
+    s.f.phase = phase
+    if phase == "copying" then
+        s.copy_at = ST.system.monotime()
+        s.copy_base = s.f.files_done
+    end
+    ST.flush()
+end
+
+function ST.rebase()
+    local s = ST.cur
+    if s then
+        s.copy_at = ST.system.monotime()
+        s.copy_base = s.f.files_done
+    end
+end
+
+function ST.field(key, value)
+    if ST.cur then
+        ST.cur.f[key] = value
+    end
+end
+
+function ST.error(err)
+    if ST.cur then
+        ST.cur.f.error = (tostring(err):gsub("[\r\n\t]", " "))
+    end
+end
+
+function ST.begin_copy(plan, pooled, workers)
+    local s = ST.cur
+    if not s then
+        return
+    end
+    local bytes = 0
+    local dirs = 0
+    for r = 1, #plan.records do
+        local rec = plan.records[r]
+        if rec.kind == "dir" then
+            dirs = dirs + 1
+        elseif rec.kind == "file" then
+            for i = 1, #plan.destinations do
+                local found = plan.destinations[i].index[rec.path]
+                if found and found.kind == "copy" then
+                    bytes = bytes + (rec.size or 0)
+                    break
+                end
+            end
+        end
+    end
+    s.dirs = dirs
+    s.f.stamp = plan.stamp or s.f.stamp
+    s.f.files_total = #plan.records
+    s.f.bytes_total = bytes
+    s.f.files_done = 0
+    s.f.bytes_done = 0
+    if pooled then
+        s.f.workers = workers
+        s.f.progress_source = "parent, per finished copy job (workers report each file when done; bytes inside a file in flight are not seen); dirs count at setup, hardlinks and symlinks after the copies"
+        s.last_dest = "all destinations (worker pool)"
+    else
+        s.f.workers = 1
+        s.f.progress_source = "parent, per record; bytes per chunk"
+    end
+    ST.phase("copying")
+end
+
+function ST.open(cmd, cfg, pid)
+    local path = cmd.status_file
+    if not path and type(cfg.report_dir) == "string" then
+        local dir = cfg.report_dir:gsub("/+$", "")
+        local parent = dir:match("^(.*)/[^/]+$")
+        if parent and parent ~= "" then
+            path = parent .. "/status.json"
+        end
+    end
+    if not path then
+        return
+    end
+    local holder = ST.dirname(path)
+    ST.cur = {
+        path = path,
+        ticks = 0,
+        written = 0,
+        f = {
+            pid = tonumber(pid) or pid,
+            profile = holder and holder:match("([^/]+)$"),
+            config = cmd.config or cmd.index,
+            phase = "starting",
+            files_done = 0,
+            bytes_done = 0,
+            started = ST.iso(),
+        },
+    }
+    ST.flush()
+end
+
+function ST.finish(code)
+    local s = ST.cur
+    if not s then
+        return
+    end
+    s.f.exit_code = code
+    if code == 0 then
+        s.f.phase = "done"
+    else
+        s.f.phase = "failed"
+    end
+    s.f.finished = ST.iso()
+    ST.flush()
+    ST.cur = nil
+end
+
